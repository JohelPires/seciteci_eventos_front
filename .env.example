# Copie para .env.local (não commitado) e ajuste para o seu ambiente.

# API do backend (URL absoluta; entra no bundle no build).
NEXT_PUBLIC_API_URL=http://localhost:3030

# Caminho base quando publicado sob um prefixo (VM da SECITECI), ex.:
#   /dev/secitec/conectese
# Vazio no dev local (app na raiz).
NEXT_PUBLIC_BASE_PATH=
