# Copie para .env.local (não commitado) e ajuste para o seu ambiente.

# API do backend (URL absoluta; entra no bundle no build).
NEXT_PUBLIC_API_URL=http://localhost:3030

# Caminho base quando publicado sob um prefixo (VM da SECITECI), ex.:
#   /dev/secitec/conectese
# Vazio no dev local (app na raiz).
NEXT_PUBLIC_BASE_PATH=

# OAuth Client ID do Google (Web application) para o login com Google —
# o MESMO valor do GOOGLE_CLIENT_ID do backend (a audience tem que bater).
# Client ID é público; não há segredo no front. Sem ele, o botão "Continuar
# com o Google" não aparece no diálogo de login. Entra no bundle no build.
# No Google Cloud, as Authorized JavaScript origins precisam cobrir cada
# origem em que o front roda (localhost:3000, apps.risc.unemat.br,
# conectese.secitec.mt.gov.br).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
