# Copie para .env.local (não commitado) e ajuste para o seu ambiente.

# API do backend (URL absoluta; entra no bundle no build).
NEXT_PUBLIC_API_URL=http://localhost:3030

# Caminho base quando publicado sob um prefixo (VM da SECITECI), ex.:
#   /dev/secitec/conectese
# Vazio no dev local (app na raiz).
NEXT_PUBLIC_BASE_PATH=

# Clerk (login): padrao fic_dev/padroes-servicos/clerk.md.
# Publishable key da instancia do ambiente (dashboard.clerk.com → API keys):
#   dev local / RISC  → instância Development (pk_test_…)
#   produção (main)   → instância Production   (pk_live_…)
# A publishable key é pública (entra no bundle no build); a CLERK_SECRET_KEY é
# do BACKEND e nunca vai no front. O mesmo projeto/instância do backend:
# instâncias diferentes = login passa e a API responde 403.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
